# ============================================
# SUPABASE (banco de dados, cadastro e login)
# ============================================
# 1. Crie uma conta gratuita em https://supabase.com
# 2. Crie um novo projeto (região: South America - São Paulo)
# 3. Vá em Project Settings > API
# 4. Copie "Project URL" e cole abaixo em VITE_SUPABASE_URL
# 5. Copie a chave "anon public" e cole abaixo em VITE_SUPABASE_ANON_KEY
#    (NUNCA use a chave "service_role" aqui — essa é secreta e não pode
#    ir para o navegador do cliente)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Copie a chave "service_role" (na mesma página Project Settings > API).
# ATENÇÃO: essa chave é SECRETA — nunca coloque o prefixo VITE_ nela, nunca
# a exponha no front-end. Ela só é usada no servidor (checkout, webhook).
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# MERCADO PAGO (pagamento)
# ============================================
# Painel: https://www.mercadopago.com.br/developers/panel/app
#
# 1. Access Token: em "Credenciais de produção" (ou "de teste" pra testar
#    sem cobrar de verdade). É SECRETO — nunca leva o prefixo VITE_.
MERCADOPAGO_ACCESS_TOKEN=
#
# 2. Public Key: mesma página de credenciais. Essa é pública e vai para o
#    navegador — é o que faz o formulário de pagamento aparecer no site.
VITE_MERCADOPAGO_PUBLIC_KEY=
#
# 3. Configure a URL de notificação (webhook) direto no painel do Mercado
#    Pago: Sua aplicação > Webhooks > Configurar notificações > eventos
#    "Pagamentos" > URL: https://SEUSITE.com/api/mercadopago/webhook
